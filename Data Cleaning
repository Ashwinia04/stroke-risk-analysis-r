# ------------------------------------------------------------
# STEP 6: DATA NORMALIZATION
# ------------------------------------------------------------

# Min-Max normalization for age
stroke_clean$age_normalized <- (
  stroke_clean$age - min(stroke_clean$age)
) / (
  max(stroke_clean$age) - min(stroke_clean$age)
)

# Min-Max normalization for average glucose level
stroke_clean$glucose_normalized <- (
  stroke_clean$avg_glucose_level -
    min(stroke_clean$avg_glucose_level)
) / (
  max(stroke_clean$avg_glucose_level) -
    min(stroke_clean$avg_glucose_level)
)

# Min-Max normalization for BMI
stroke_clean$bmi_normalized <- (
  stroke_clean$bmi -
    min(stroke_clean$bmi)
) / (
  max(stroke_clean$bmi) -
    min(stroke_clean$bmi)
)

# Check normalized variables
