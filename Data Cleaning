bmi_missing_percentage <- round(
  bmi_na_count / nrow(stroke_data) * 100,
  2
)

bmi_missing_percentage

# ------------------------------------------------------------
# STEP 4: CREATE CLEANING COPY
# ------------------------------------------------------------

# Preserve the original dataset and create a working copy
stroke_clean <- stroke_data

# Replace "N/A" text with proper R missing values
stroke_clean$bmi[stroke_clean$bmi == "N/A"] <- NA

# Convert BMI from character to numeric
stroke_clean$bmi <- as.numeric(stroke_clean$bmi)

# Verify BMI data type
str(stroke_clean$bmi)

# Count missing BMI observations after conversion
sum(is.na(stroke_clean$bmi))

# Calculate median BMI excluding missing values
median_bmi <- median(
  stroke_clean$bmi,
  na.rm = TRUE
)

median_bmi

# Impute missing BMI values using the median
stroke_clean$bmi[is.na(stroke_clean$bmi)] <- median_bmi
# Verify BMI missing values after imputation
sum(is.na(stroke_clean$bmi))
# Check missing values across the cleaned dataset
colSums(is.na(stroke_clean))
# Verify cleaned dataset structure
str(stroke_clean)

# Compare original and cleaned BMI summaries
summary(stroke_data$bmi)
summary(stroke_clean$bmi)

summary(as.numeric(stroke_data$bmi[stroke_data$bmi != "N/A"]))
summary(stroke_clean$bmi)

# Check for potentially invalid BMI values
sum(stroke_clean$bmi <= 0)
# Save cleaned dataset
write.csv(
  stroke_clean,
  "Data/stroke_cleaned.csv",
  row.names = FALSE
)

